# Go sources are kept with LF line endings on every system (gofmt expects them).
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.md   text eol=lf
*.png  binary
*.yml  text eol=lf
*.sh   text eol=lf
# Go fuzz corpus entries are parsed line by line: LF everywhere.
tests/testdata/fuzz/** text eol=lf
*.icc binary
*.s text eol=lf
# Netpbm and QOI files are compared to the byte: kept as they are.
*.pbm binary
*.pgm binary
*.ppm binary
*.qoi binary
**/testdata/fuzz/** text eol=lf
# Test files compared to the byte.
*.zst binary
*.tif binary
*.dds binary
*.fits binary
*.pcx binary
*.sgi binary
*.xbm -text
*.xpm -text
